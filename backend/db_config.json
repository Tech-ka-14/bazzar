  "sources": {
    "rbi": {
      "base_url": "https://data.rbi.org.in",
      "gateway_path": "/CIMS_Gateway_DBIE/GATEWAY/SERVICES",
      "token_service": "security_generateSessionToken",
      "data_service": "dbie_getImpalaDQActionEnhanced",
      "channel_key": "key2",
      "note": "RBI DBIE gateway shape verified 2026-10 (dbie-portal-anatomy.md of the RBIH dbie.rbihub.in mirror). Series data responses are HTML-entity-encoded JSON; rows carry SDMX columns TIME_PERIOD / OBS_VALUE plus per-dimension description columns. The SPA AES-256-CBC-encrypts data-query request fields with a static bundle key; if RBI enforces that on the wire, fetches fail loudly and sync records a failed/partial run (never fabricate).",
      "macro_series": {
        "repo_rate": {
          "service": "dbie_getImpalaDQActionEnhanced",
          "params": {},
          "note": "Policy rates are NOT in the DBIE SDMX data-query catalogue; they live in the 'Key Rates' indicators report (report id 531) behind the BOE OpenDocument guest-token chain. Empty params = skipped with a log line until that chain is wired (P4 follow-up)."
        },
        "reverse_repo_rate": {
          "service": "dbie_getImpalaDQActionEnhanced",
          "params": {},
          "note": "See repo_rate."
        },
        "crr": {
          "service": "dbie_getImpalaDQActionEnhanced",
          "params": {},
          "note": "See repo_rate."
        },
        "forex_reserves": {
          "service": "dbie_getImpalaDQActionEnhanced",
          "params": {
            "dsdCode": "FR_EXG_RESV_RN"
          },
          "dimension_column": "typ_maj_fr_exc_res_rn_description",
          "dimension_values": [
            "FER_TTL",
            "Foreign Exchange Reserves"
          ],
          "value_scale": 0.001,
          "note": "Weekly forex reserves, total (FER_TTL) in US dollars. DBIE/WSS publishes US$ million (SDMX UNIT_MULT=6); registry unit is USD bn -> value_scale 0.001."
        }
      },
      "benchmark_series": {
        "in_gsec_10y": {
          "service": "dbie_getImpalaDQActionEnhanced",
          "params": {
            "dsdCode": "YIELD_GOV_SEC_RN"
          },
          "dimension_column": "mat_per_rn_description",
          "dimension_values": [
            "10"
          ],
          "note": "Monthly yield of SGL transactions in government dated securities, residual maturity 10 years (percent)."
        },
        "in_gsec_5y": {
          "service": "dbie_getImpalaDQActionEnhanced",
          "params": {
            "dsdCode": "YIELD_GOV_SEC_RN"
          },
          "dimension_column": "mat_per_rn_description",
          "dimension_values": [
            "5"
          ],
          "note": "Same element as in_gsec_10y, residual maturity 5 years."
        },
        "in_gsec_91d": {
          "service": "dbie_getImpalaDQActionEnhanced",
          "params": {
            "dsdCode": "YIELD_TB_RN"
          },
          "dimension_column": "mat_term_d_rn_description",
          "dimension_values": [
            "15TO91",
            "15-91 days"
          ],
          "note": "Monthly yield of SGL transactions in treasury bills, 15-91 days residual maturity (91-day T-bill), percent."
        },
        "rbi_repo": {
          "service": "dbie_getImpalaDQActionEnhanced",
          "params": {},
          "note": "Date-keyed repo rate; same 'Key Rates' report gap as the repo_rate macro series (see sources.rbi note)."
        }
      }
    },
    "us_treasury": {
      "series_key": "us_10y",
      "base_url_template": "https://home.treasury.gov/resource-center/data-chart-center/interest-rates/daily-treasury-rates.csv/{year}/all?type=daily_treasury_yield_curve&field_tdr_date_value={year}&page&_format=csv",
      "date_column": "Date",
      "yield_columns": [
        "BC_10YEAR",
        "10 Yr"
      ],
      "note": "Daily Treasury par yield curve rates CSV; BC_10YEAR is the current column name, '10 Yr' the legacy one."
    },
    "fred": {
      "series_key": "us_fed_funds",
      "base_url": "https://api.stlouisfed.org/fred/series/observations",
      "fred_series_id": "FEDFUNDS",
      "note": "Effective federal funds rate, monthly, percent; observation date is the first of the month. API key via FRED_API_KEY."
    },
    "ogd": {
      "base_url": "https://api.data.gov.in",
      "resource_path": "/resource",
      "format": "json",
      "limit": 100,
      "note": "Open Government Data (data.gov.in) API — GET {base_url}/resource/{resource_id}?api-key={OGD_API_KEY}&format=json&limit=... returns {\"records\": [...]}. Resource IDs were located 2026-10 via public OGD usage (the data.gov.in site 403s scripted catalog access) and could not be re-verified live from the build environment; field-name candidates are best-effort — rows lacking the configured fields are dropped, never defaulted. Empty resource_id = no live OGD series exists (skipped with a log line; unsynced beats fabricated).",
      "resources": {
        "cpi_inflation": {
          "resource_id": "9d67b242-0243-4298-adf9-7617dbeba7ab",
          "value_field": ["inflation_rate", "yoy_inflation", "inflation", "value"],
          "period_field": ["period", "month", "year_month", "date"],
          "period_format": "monthly",
          "note": "All-India CPI headline retail inflation (% YoY), monthly. Resource id live-confirmed against api.data.gov.in on 2026-08-21 (via api.data.gov.in/lists catalog search; documented in public OGD client code). Exact field names unverified from the build environment — candidates listed in priority order, first non-null cell wins."
        },
        "wpi_inflation": {
          "resource_id": "239ac3d0-f08d-40d0-b03c-9b7a426a62d5",
          "value_field": ["inflation_rate", "yoy_inflation", "inflation", "wpi_inflation", "value"],
          "period_field": ["period", "month", "year_month", "date"],
          "period_format": "monthly",
          "note": "Wholesale Price Index (Base Year 2011-12), monthly, 'till last month' — resource id live-confirmed 2026-08-21 (same provenance as cpi_inflation). If the dataset publishes the index level rather than the YoY rate the value_field mapping must be corrected before trusting synced values."
        },
        "iip": {
          "resource_id": "",
          "value_field": ["value"],
          "period_field": ["period", "month"],
          "period_format": "monthly",
          "note": "GAP (documented 2026-10): no live IIP OGD resource — data.gov.in carries only stale/one-off IIP tables; MoSPI publishes IIP via eSankhyiki (api.mospi.gov.in) and PIB releases. Skipped with a log line until an eSankhyiki fetcher is wired (P4 follow-up)."
        },
        "gdp_growth": {
          "resource_id": "",
          "value_field": ["value"],
          "period_field": ["period", "quarter"],
          "period_format": "quarterly",
          "note": "GAP (documented 2026-10): GDP growth is not published as an OGD resource — MoSPI releases it via press note / PIB (quarterly NAS). Skipped with a log line until an eSankhyiki fetcher is wired (P4 follow-up)."
        }
      }
    },
    "nse_open": {
      "base_url": "https://www.nseindia.com",
      "holidays_path": "/api/holiday-master?type=trading",
      "fii_dii_path": "/api/fiidiiTradeReact",
      "constituents_path": "/api/equity-stockIndices",
      "holiday_segments": ["CM"],
      "constituent_cache_hours": 6,
      "note": "NSE public JSON APIs (undocumented but stable). holiday-master returns segment-keyed holiday lists (CM = capital market); special trading sessions (Muhurat) are parsed as trading days, matching backend/data/nse_calendar.csv. fiidiiTradeReact returns flat FII/DII rows in ₹ crore. equity-stockIndices?index=... is cached under BAZZAR_DATA_DIR/cache/nse/. The site sits behind a cookie wall — a plain GET to the base URL bootstraps the session."
    }
  }
