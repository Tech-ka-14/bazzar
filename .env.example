# Bazzar Terminal — data layer credentials (copy to .env and fill in; .env is
# gitignored and must NEVER be committed).
#
# Market data flows through a self-hosted OpenAlgo instance with the Motilal
# Oswal broker. See:
# https://github.com/marketcalls/openalgo-docs/blob/main/connect-brokers/brokers/motilal-oswal.md

# OpenAlgo host base URL (local OpenAlgo server).
OPENALGO_BASE_URL=http://127.0.0.1:5000

# OpenAlgo host API key (from the OpenAlgo dashboard).
OPENALGO_API_KEY=

# Motilal Oswal broker credentials: BROKER_API_KEY is your Motilal client code,
# BROKER_API_SECRET is the generated API key from the Motilal Oswal API portal.
BROKER_API_KEY=
BROKER_API_SECRET=

# Market data provider (P3): kite (primary, Zerodha Kite Connect),
# openalgo (self-hosted fallback), nse_bhavcopy (free EOD fallback).
MARKET_DATA_PROVIDER=openalgo

# Kite Connect API key from https://developers.kite.trade (non-secret — this
# is the ONLY Kite value allowed in .env). The API secret and the daily
# access token live in the OS keyring ONLY, never here:
#   python -m backend.kite_auth set-secret
KITE_API_KEY=

# Bazzar data directory (holds bazzar.duckdb and the chart cache; gitignored).
BAZZAR_DATA_DIR=./data

# Local API port for `python3 -m backend.server`.
BAZZAR_API_PORT=8787

# --- open-data source API keys (P4) --------------------------------------
# FRED API key for the us_fed_funds benchmark (free, non-secret public key;
# sign up at https://fred.stlouisfed.org/docs/api/api_key.html). When unset,
# the FRED leg of the international benchmark sync is skipped — never fabricated.
FRED_API_KEY=

# Open Government Data (data.gov.in) API key, used by the P4-B OGD fetchers
# (free public key; sign up at https://data.gov.in/user).
OGD_API_KEY=
